# Copy to .env.local. Never commit real values.
# Same database the pipeline loads (see pipeline/.env.example). Port 5433 is the local docker database.
DATABASE_URL=postgresql://dpi:dpi_local_only@localhost:5433/dpi

# Public address of the site, for share previews, the sitemap and robots.txt. Optional: on Vercel the production
# address is used when this is empty. Set it once a custom domain is chosen.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Walk and Drive minutes on the map (Phase 5). Off unless ALL three are set. Any OSRM-compatible service works, one for
# walking and one for driving. The public FOSSGIS servers need no key but are for light use only; for real traffic
# self-host OSRM or use a paid provider. Never commit real addresses with keys in them.
# ROUTING_ENABLED=1
# ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# ROUTING_CAR_URL=https://routing.openstreetmap.de/routed-car
