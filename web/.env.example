# Copy to .env.local. Never commit real values.
# Same database the pipeline loads (see pipeline/.env.example). Port 5433 is the local docker database.
DATABASE_URL=postgresql://dpi:dpi_local_only@localhost:5433/dpi

# Public address of the site, for share previews, the sitemap and robots.txt. Optional: on Vercel the production
# address is used when this is empty. Set it once a custom domain is chosen.
# NEXT_PUBLIC_SITE_URL=https://example.com
