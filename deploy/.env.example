# Copy to deploy/.env on the server (cp .env.example .env) and fill in. Never commit .env.
# Public hostname of the site. Temporary options: srvNNNNNN.hstgr.cloud (shown in hPanel) or 203-0-113-10.sslip.io.
SITE_HOST=203-0-113-10.sslip.io
# Generate each password with: openssl rand -hex 24   (hex only, so it is safe inside a URL)
DB_PASSWORD=change-me
WEB_DB_PASSWORD=change-me
# Walking and driving minutes. Leave 0 until you have run scripts/prepare-routing.sh and started the routing profile.
ROUTING_ENABLED=0
# Seconds identical database queries are reused (the site only changes when you load new data).
DB_CACHE_SECONDS=300
